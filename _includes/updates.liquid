{% assign updates = site.posts | sort: 'date' | reverse %}
{% assign updates_limit = include.limit | default: updates.size %}
{% if updates.size > 0 %}
  <ul class="post-list">
    {% for item in updates limit: updates_limit %}
      <li>
        <p class="post-meta">
          <time datetime="{{ item.date | date_to_xmlschema }}">{{ item.date | date: '%b %d, %Y' }}</time>
        </p>
        <h3 class="mt-2">
          <a href="{{ item.url | relative_url }}">{{ item.title | escape }}</a>
        </h3>
        {% if item.description %}
          <p class="mb-0">{{ item.description | escape }}</p>
        {% else %}
          <p class="mb-0">{{ item.excerpt | strip_html | truncatewords: 40 }}</p>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
{% else %}
  <p class="text-muted">No updates yet.</p>
{% endif %}
